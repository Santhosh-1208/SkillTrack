    "title":  "Cybersecurity Incident Response",
    "branch":  "CSE",
    "level":  3,
    "interaction_pattern":  "investigative_branching",
    "goal":  "Detect, contain, and report a suspected security breach on a company workstation while preserving evidence and following the incident-response SLA.",
    "has_3d_viewer":  false,
    "three_model_url":  null,
    "category":  "IT \u0026 DevOps",
    "learning_content":  {
                             "what":  "Cybersecurity Incident Response (IR) is a structured approach to handling security breaches, malware infections, and system compromises. The NIST IR framework defines six phases: Preparation → Detection → Containment → Eradication → Recovery → Lessons Learned. The average cost of a data breach is $4.45 million — fast, correct response directly limits this damage.",
                             "how":  "On alert: contain first (network isolate the machine without powering it off) → collect volatile evidence (memory snapshot) → investigate (review logs and running processes) → escalate to the IR lead with findings → remediate only after receiving approval → file a full incident report. Never shut down a compromised machine — RAM evidence (running processes, encryption keys, open network connections) is permanently lost on power-off."
                         },
    "prerequisites":  [

                      ],
    "time_limit_seconds":  600,
    "sop_steps":  [
                      {
                          "step_id":  "CY_S1",
                          "order":  1,
                          "instruction":  "Acknowledge the security alert within SLA.",
                          "expected_action":  "acknowledge_alert",
                          "is_safety_critical":  false,
                          "hint":  "SLA clock starts the moment the alert fires."
                      },
                      {
                          "step_id":  "CY_S2",
                          "order":  2,
                          "instruction":  "Isolate the affected machine from the network (do not power off).",
                          "expected_action":  "isolate_from_network",
                          "is_safety_critical":  true,
                          "hint":  "Disconnect network access, but keep the machine running to preserve volatile memory evidence."
                      },
                      {
                          "step_id":  "CY_S3",
                          "order":  3,
                          "instruction":  "Capture a memory/process snapshot before any further action.",
                          "expected_action":  "capture_snapshot",
                          "is_safety_critical":  true,
                          "hint":  "This is your only chance to capture volatile evidence."
                      },
                      {
                          "step_id":  "CY_S4",
                          "order":  4,
                          "instruction":  "Review recent process list and network connection logs for anomalies.",
                          "expected_action":  "review_logs",
                          "is_safety_critical":  false,
                          "hint":  "Look for unfamiliar outbound connections or unsigned processes."
                      },
                      {
                          "step_id":  "CY_S5",
                          "order":  5,
                          "instruction":  "Identify the likely malicious process/file based on log evidence.",
                          "expected_action":  "identify_threat",
                          "is_safety_critical":  false,
                          "hint":  null
                      },
                      {
                          "step_id":  "CY_S6",
                          "order":  6,
                          "instruction":  "Escalate to the incident response lead with a summary of findings.",
                          "expected_action":  "escalate_findings",
                          "is_safety_critical":  false,
                          "hint":  "Include what was found, when, and containment actions already taken."
                      },
                      {
                          "step_id":  "CY_S7",
                          "order":  7,
                          "instruction":  "Begin remediation only after escalation is acknowledged.",
                          "expected_action":  "begin_remediation",
                          "is_safety_critical":  true,
                          "hint":  null
                      },
                      {
                          "step_id":  "CY_S8",
                          "order":  8,
                          "instruction":  "File the incident report documenting timeline and evidence chain.",
                          "expected_action":  "file_incident_report",
                          "is_safety_critical":  false,
                          "hint":  null
                      }
                  ],
