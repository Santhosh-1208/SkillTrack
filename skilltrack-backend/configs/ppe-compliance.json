{
    "simulation_id":  "PPE_COMPLIANCE_001",
    "title":  "PPE Compliance \u0026 Inspection",
    "branch":  "All",
    "level":  1,
    "interaction_pattern":  "checklist",
    "goal":  "Select, inspect, and correctly wear the appropriate personal protective equipment before entering a hazard zone.",
    "has_3d_viewer":  false,
    "three_model_url":  null,
    "category":  "Safety \u0026 HSE",
    "learning_content":  {
                             "what":  "Personal Protective Equipment (PPE) is any device or garment worn to minimise exposure to workplace hazards. Employers must assess risks and provide appropriate PPE free of charge under health and safety regulations. PPE is the last line of defence — it does not eliminate the hazard, it only reduces risk.",
                             "how":  "Select PPE based on the specific hazard type (chemical, impact, heat). Inspect every item before use for cracks, tears, or expiry. Wear in the correct sequence to ensure seals and closures work properly. Never use damaged PPE — replace it immediately. Always confirm at the compliance checkpoint before entering a hazard zone."
                         },
    "prerequisites":  [

                      ],
    "time_limit_seconds":  null,
    "sop_steps":  [
                      {
                          "step_id":  "PPE_S1",
                          "order":  1,
                          "instruction":  "Identify the hazard zone and required PPE category from the posted signage.",
                          "expected_action":  "identify_ppe_requirement",
                          "is_safety_critical":  false,
                          "hint":  "Check the hazard sign at the zone entrance — it lists required PPE."
                      },
                      {
                          "step_id":  "PPE_S2",
                          "order":  2,
                          "instruction":  "Select safety helmet from the PPE rack.",
                          "expected_action":  "select_helmet",
                          "is_safety_critical":  true,
                          "hint":  "Helmets are color-coded by role; pick the one matching your assigned role."
                      },
                      {
                          "step_id":  "PPE_S3",
                          "order":  3,
                          "instruction":  "Inspect helmet for cracks or damage before wearing.",
                          "expected_action":  "inspect_helmet",
                          "is_safety_critical":  true,
                          "hint":  "Look for hairline cracks near the shell edge and check the strap."
                      },
                      {
                          "step_id":  "PPE_S4",
                          "order":  4,
                          "instruction":  "Select and inspect safety goggles.",
                          "expected_action":  "inspect_goggles",
                          "is_safety_critical":  true,
                          "hint":  "Goggles should have no scratches obstructing vision."
                      },
                      {
                          "step_id":  "PPE_S5",
                          "order":  5,
                          "instruction":  "Select and inspect gloves rated for the task.",
                          "expected_action":  "inspect_gloves",
                          "is_safety_critical":  true,
                          "hint":  "Match glove rating (cut/chemical/heat) to the task on the signage."
                      },
                      {
                          "step_id":  "PPE_S6",
                          "order":  6,
                          "instruction":  "Select safety footwear and verify sole condition.",
                          "expected_action":  "inspect_footwear",
                          "is_safety_critical":  false,
                          "hint":  "Steel-toe boots with intact soles are required in this zone."
                      },
                      {
                          "step_id":  "PPE_S7",
                          "order":  7,
                          "instruction":  "Don all selected PPE and verify fit (straps, seals, closures).",
                          "expected_action":  "wear_and_verify_fit",
                          "is_safety_critical":  true,
                          "hint":  "A loose chinstrap or gaping goggle seal counts as improper fit."
                      },
                      {
                          "step_id":  "PPE_S8",
                          "order":  8,
                          "instruction":  "Confirm compliance at the checkpoint scanner before entry.",
                          "expected_action":  "confirm_checkpoint",
                          "is_safety_critical":  false,
                          "hint":  "The scanner checks that all required PPE items are logged as worn."
                      }
                  ],
